  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'); fs.mkdirSync('public/vendor',{recursive:true}); if(!fs.existsSync('public/vendor/chart.umd.js') && fs.existsSync('node_modules/chart.js/dist/chart.umd.js')) fs.copyFileSync('node_modules/chart.js/dist/chart.umd.js','public/vendor/chart.umd.js');\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
